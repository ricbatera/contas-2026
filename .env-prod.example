# Copie para .env-prod (não versionado) e preencha os segredos.
# Uso: docker compose --env-file .env-prod up -d --build

POSTGRES_DB=financas
POSTGRES_USER=financas
POSTGRES_PASSWORD=

# Mínimo de 32 bytes (HS256). Gere com: openssl rand -base64 48
JWT_SECRET=

# Chave AES-256 que cifra as API keys dos provedores de IA. Gere com: openssl rand -base64 32
# Não troque depois de cadastrar provedores: as chaves gravadas ficariam ilegíveis.
IA_CRYPTO_KEY=

# Porta do host onde o frontend (nginx) fica exposto
APP_PORT=80

# true para expor /swagger-ui.html e /v3/api-docs no backend
SWAGGER_ENABLED=false
